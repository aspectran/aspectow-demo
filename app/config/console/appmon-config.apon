app: {
    id: root
    title: Root
    event: {
        id: activity
        target: root
        parameters: {
            +: /**
        }
    }
    event: {
        id: session
        target: tow.server/root
    }
    metric: {
        id: cpu
        title: CPU
        description: Shows JVM process and system CPU usage
        reader: com.aspectran.aspectow.appmon.engine.exporter.metric.jvm.CpuUsageReader
        sampleInterval: 1000
        heading: true
    }
    metric: {
        id: heap
        title: Heap
        description: Shows JVM Heap memory usage status
        reader: com.aspectran.aspectow.appmon.engine.exporter.metric.jvm.HeapMemoryUsageReader
        sampleInterval: 500
        heading: true
    }
    metric: {
        id: undertow-tp
        title: Undertow TP
        description: Metrics of Undertow thread pool resources
        reader: com.aspectran.aspectow.appmon.engine.exporter.metric.undertow.UndertowThreadPoolMetricsReader
        target: tow.server
        sampleInterval: 30
        exportInterval: 900
        heading: true
    }
    log: {
        id: app
        title: Root App
        file: /logs/root.log
        lastLines: 300
        sampleInterval: 300
    }
    log: {
        id: access
        title: Root Access
        file: /logs/root-access.log
        lastLines: 100
        sampleInterval: 300
    }
}
