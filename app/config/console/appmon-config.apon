# Polling configuration used only when WebSocket is not supported
pollingConfig: {
    # The interval in milliseconds at which the client polls the server for new messages
    pollingInterval: 3000
    # The duration in milliseconds after which an inactive polling session expires
    sessionTimeout: 30000
}
app: {
    id: console-console
    title: Console
    hidden: true
    event: {
        id: activity
        target: console
        parameters: {
            +: /**
            -: /nodes/**/polling/**  # Ignore polling requests
        }
    }
    event: {
        id: session
        target: tow.server/console
        parameters: {
            usernameAttribute: USER_INFO.username
        }
    }
    log: {
        id: app
        file: console.log
        sampleInterval: 300
        lastLines: 100
    }
    log: {
        id: access
        file: console-access.log
        sampleInterval: 300
        lastLines: 100
    }
}
app: {
    id: jpetstore
    title: JPetStore
    event: {
        id: activity
        target: jpetstore
        parameters: {
            +: /**
        }
    }
    event: {
        id: session
        target: tow.server/jpetstore
        parameters: {
            usernameAttribute: user.account.username
        }
    }
    metric: {
        id: jpetstore-cp
        title: JPetStore CP
        description: Shows the JDBC connection pool usage status
        reader: com.aspectran.aspectow.appmon.engine.exporter.metric.jdbc.HikariPoolMBeanReader
        parameters: {
            poolName: jpetstore
        }
        sampleInterval: 50
        exportInterval: 900
    }
    log: {
        id: app
        title: JPetStore App
        file: /logs/jpetstore.log
        lastLines: 300
        sampleInterval: 300
    }
    log: {
        id: access
        title: JPetStore Access
        file: /logs/jpetstore-access.log
        lastLines: 100
        sampleInterval: 300
    }
}
