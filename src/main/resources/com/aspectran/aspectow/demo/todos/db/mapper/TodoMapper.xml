<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.aspectran.aspectow.demo.todos.TodoDao">

    <resultMap id="todoResultMap" type="com.aspectran.aspectow.demo.todos.Todo">
        <id property="id" column="id"/>
        <result property="title" column="title"/>
        <result property="completed" column="completed"/>
        <result property="order" column="order_num"/>
    </resultMap>

    <select id="selectTodos" resultMap="todoResultMap">
        SELECT id, title, completed, order_num
        FROM todos
        ORDER BY id ASC
    </select>

    <select id="selectTodoById" parameterType="long" resultMap="todoResultMap">
        SELECT id, title, completed, order_num
        FROM todos
        WHERE id = #{id}
    </select>

    <insert id="insertTodo" parameterType="com.aspectran.aspectow.demo.todos.Todo" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO todos (title, completed, order_num)
        VALUES (#{title}, #{completed}, #{order})
    </insert>

    <update id="updateTodo" parameterType="com.aspectran.aspectow.demo.todos.Todo">
        UPDATE todos
        <set>
            <if test="title != null">title = #{title},</if>
            <if test="completed != null">completed = #{completed},</if>
            <if test="order != null">order_num = #{order},</if>
        </set>
        WHERE id = #{id}
    </update>

    <delete id="deleteTodoById" parameterType="long">
        DELETE FROM todos
        WHERE id = #{id}
    </delete>

    <delete id="deleteAllTodos">
        DELETE FROM todos
    </delete>

</mapper>
